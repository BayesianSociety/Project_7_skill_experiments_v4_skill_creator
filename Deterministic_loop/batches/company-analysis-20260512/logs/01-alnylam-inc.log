            "text": "The main risks are TTR concentration, extrahepatic delivery uncertainty, manufacturing execution, and royalty/financing burdens.",
            "claim_type": "limitation",
            "confidence": "Medium",
            "evidence_ids": ["ev_red_flags", "ev_economic_constraints"],
            "source_ids": ["src_sec_2025_10k"],
        },
        {
            "claim_id": "claim_bottom_line",
            "section": "bottom_line",
            "text": "Alnylam is an exceptional innovator on absolute readiness, with the next proof points in siRELIS scale-up and extrahepatic clinical validation.",
            "claim_type": "inference",
            "confidence": "Medium",
            "evidence_ids": ["ev_company_scale_2025", "ev_q1_2026", "ev_sirelis", "ev_delivery_platforms"],
            "source_ids": ["src_sec_2025_10k", "src_q1_2026_release", "src_sirelis_expansion", "src_delivery_platforms"],
        },
        {
            "claim_id": "claim_monitor_nucresiran",
            "section": "watchlist",
            "text": "Nucresiran pivotal outcomes and launch timing are key upgrade or downgrade triggers for the TTR franchise.",
            "claim_type": "monitoring_trigger",
            "confidence": "Medium",
            "evidence_ids": ["ev_pipeline_scope", "ev_q1_2026"],
            "source_ids": ["src_pipeline_2026", "src_q1_2026_release"],
        },
    ]

    return {
        "schema_version": "2.1",
        "company": "Alnylam Pharmaceuticals, Inc.",
        "ticker": "NASDAQ: ALNY",
        "mode": "absolute",
        "benchmark_ready": True,
        "skill_metadata": {
            "skill_name": "technology-innovation-analysis",
            "skill_version": "1.2.0",
            "skill_path": ".codex/skills/technology-innovation-analysis/SKILL.md",
            "scorer_name": "score_innovation_benchmark.py",
            "scorer_version": "1.2.0",
            "metric_rules_version": "1.2.0",
        },
        "research_run": {
            "research_date": "2026-05-12",
            "analyst": "codex",
            "run_id": "run-company-analysis-20260512-01",
            "user_request": "Research Alnylam Pharmaceuticals, NASDAQ: ALNY, using the technology innovation analysis skill and present a Desert Rose themed frontend dashboard.",
            "time_horizon": "Five years, primarily 2021-2025, with latest Q1 2026 operating evidence where available.",
            "research_mode": "web_research_with_deterministic_scoring",
        },
        "research_context": {
            "focus_technologies": [
                "Liver-targeted RNAi therapeutics and GalNAc/LNP delivery",
                "Extrahepatic RNAi delivery including C16/CNS, ocular, adipose and metabolic expansion",
                "siRELIS enzymatic ligation and scaled siRNA manufacturing",
            ],
            "company_identifiers": {
                "legal_name": "Alnylam Pharmaceuticals, Inc.",
                "ticker": "NASDAQ: ALNY",
                "cik": "0001178670",
                "isin": "US02043Q1076",
            },
            "source_availability": [
                {"domain": "company_filings", "status": "available", "note": "2025 and 2023 10-K filings were available through SEC archives."},
                {"domain": "company_materials", "status": "available", "note": "Q1 2026 release, pipeline page, platform pages, and manufacturing releases were available."},
                {"domain": "patents", "status": "partial", "note": "Representative public patent records were available, but not a clean assignee-normalized family-by-year export."},
                {"domain": "scientometrics", "status": "partial", "note": "PubMed/search-index proxy and representative sources were available; OpenAlex/API-style export was not reproducible in the shell sandbox."},
                {"domain": "policy", "status": "available", "note": "FDA approvals and FDA ETP/AMT policy context were available."},
