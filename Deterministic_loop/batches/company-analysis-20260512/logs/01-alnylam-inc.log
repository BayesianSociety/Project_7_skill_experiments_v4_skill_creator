                {"candidate_source_or_metric": "Paywalled patent analytics exports", "reason": "Not available in the run; public patent proxies were used and labeled."},
                {"candidate_source_or_metric": "Stock-price reaction articles", "reason": "Useful for market context but not direct innovation evidence."},
            ],
            "judgment_calls": [
                {
                    "topic": "Technology scope",
                    "decision": "Focused on liver-targeted RNAi, extrahepatic delivery, and siRNA manufacturing.",
                    "rationale": "These three domains are most material to future Alnylam innovation value.",
                    "impact": "General commercial execution outside RNAi platform technology is de-emphasized.",
                },
                {
                    "topic": "Patent trend proxy",
                    "decision": "Used visible public patent listing records as a proxy instead of family counts.",
                    "rationale": "Open sources did not provide a clean family-by-year export.",
                    "impact": "IP coverage and confidence were discounted.",
                },
                {
                    "topic": "Publication trend proxy",
                    "decision": "Used minimum confirmed PubMed/search-index records and representative reviews.",
                    "rationale": "A reproducible OpenAlex-style export was unavailable in the shell sandbox.",
                    "impact": "Science coverage is high but not maximum.",
                },
