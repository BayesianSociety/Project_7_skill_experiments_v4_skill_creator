_inputs": {"commercial_products": 6, "ttr_q1_2026_growth_pct": 153, "helios_b_patients": 655}, "method": "expert_normalized_repeatability", "parameters": {"floor": 0.0, "cap": 1.0}, "rationale": "Clinical outcome data, quarterly dosing, repeated product launches, and revenue scale support repeatable deployment.", "judgment_level": "medium"}}], "cap_reasons": []}, {"label": "Policy & Economics", "score": 3.9, "display_score": "3.9", "raw_score": 4.11, "normalized_score": 0.822, "coverage_ratio": 0.88, "confidence_penalty": 0.952, "confidence": "High", "summary": "Policy and economics are supportive overall: FDA approvals, FDA ETP engagement, and large revenue scale help, while reimbursement, royalty burdens, concentration, and manufacturing execution remain real constraints.", "strong": "AMVUTTRA ATTR-CM and Qfitlia approvals validate regulatory pathways; FDA ETP acceptance supports advanced manufacturing dialogue for siRELIS.", "missing": "Long-term payer durability, post-launch comparative effectiveness, and siRELIS cost/yield proof are not yet public.", "metrics": [{"code": "regulatory_or_standards_fit", "label": "Regulatory fit", "value": 0.86, "weight": 0.35, "unit": "normalized_0_to_1", "source_type": "mixed", "verified": true, "evidence_ids": ["ev_amvuttra_approval", "ev_qfitlia_approval", "ev_policy_support"], "normalization": {"raw_inputs": {"fda_approvals_2025": 2, "fda_etp_acceptance": true}, "method": "expert_normalized_regulatory_fit", "parameters": {"floor": 0.0, "cap": 1.0}, "rationale": "Recent FDA approvals and manufacturing-program engagement indicate strong regulatory fit.", "judgment_level": "medium"}}, {"code": "policy_or_supply_chain_support", "label": "Policy and supply chain", "value": 0.78, "weight": 0.3, "unit": "normalized_0_to_1", "source_type": "mixed", "verified": true, "evidence_ids": ["ev_policy_support", "ev_sirelis", "ev_capex"], "normalization": {"raw_inputs": {"domestic_manufacturing_expansion_usd_m": 250, "fda_etp": true}, "method