ilable", "reliability": "medium", "notes": "Representative TTR iRNA patent grant."}, {"source_id": "src_google_ttr_family", "title": "Compositions and methods for inhibiting expression of transthyretin - Patent US-12227744-B2", "url": "https://pubchem.ncbi.nlm.nih.gov/patent/US-12227744-B2", "publisher": "PubChem / Google Patents metadata", "document_date": "2025-02-18", "accessed_at": "2026-05-12", "source_type": "patent_database", "availability": "available", "reliability": "medium", "notes": "Family metadata for the TTR patent, including US, EP, CN, CA, AU, BR and other jurisdictions."}, {"source_id": "src_google_cns_patent", "title": "WO2023010134A1 - Peptide ligands for CNS and ocular delivery of RNAi compounds", "url": "https://patents.google.com/patent/WO2023010134A1/en", "publisher": "Google Patents", "document_date": "2023-02-02", "accessed_at": "2026-05-12", "source_type": "patent_database", "availability": "available", "reliability": "medium", "notes": "Representative extrahepatic delivery patent family with WO/PCT, EP and US records."}, {"source_id": "src_fda_etp", "title": "Emerging Technology Program", "url": "https://www.fda.gov/about-fda/center-drug-evaluation-and-research-cder/emerging-technology-program-etp", "publisher": "U.S. Food and Drug Administration", "document_date": "2026", "accessed_at": "2026-05-12", "source_type": "regulator", "availability": "available", "reliability": "high", "notes": "FDA program context for innovative pharmaceutical manufacturing technology engagement."}, {"source_id": "src_fda_amt_guidance", "title": "Advanced Manufacturing Technologies Designation Program", "url": "https://www.fda.gov/regulatory-information/search-fda-guidance-documents/advanced-manufacturing-technologies-designation-program", "publisher": "U.S. Food and Drug Administration", "document_date": "2024-12", "accessed_at": "2026-05-12", "source_type": "regulator_guidance", "availability": "available", "reliability": "high", "notes": "Advanced manufacturing policy context."}], "evidence_items": [{"evidence_id": "ev_company_scale_2025", "source_id": "src_sec_2025_10k", "layer": "Adoption", "metric_codes": ["revenue_or_booking_evidence", "repeatability_or_deployment_scale"], "fact_type": "raw_observation", "fact": "As of December 31, 2025, Alnylam had six marketed products, including two products commercialized by collaborators, more than 20 clinical programs, and $2.987 billion of net product revenue.", "raw_value": 2986.549, "raw_unit": "USD millions net product revenue", "period_start": "2025", "period_end": "2025", "company_attributable": true, "field_proxy": false, "quote_or_excerpt": "six marketed products, including two products commercialized by collaborators", "location": "Form 10-K overview and statement of operations", "verified": true, "limitations": "Product-level patient counts were not disclosed."}, {"evidence_id": "ev_revenue_trend", "source_id": "src_sec_2025_10k", "layer": "Adoption", "metric_codes": ["revenue_or_booking_evidence"], "fact_type": "raw_observation", "fact": "Net product revenue grew from about $662 million in 2021 to $2.987 billion in 2025, with the largest step-change after AMVUTTRA's ATTR-CM launch.", "raw_value": 2986.549, "raw_unit": "USD millions", "period_start": "2021", "period_end": "2025", "company_attributable": true, "field_proxy": false, "quote_or_excerpt": "", "location": "2025 10-K and 2023 10-K statements of operations", "verified": true, "limitations": "2021 and 2022 values use the 2023 filing; values are rounded in dashboard charts."}, {"evidence_id": "ev_rd_trend", "source_id": "src_sec_2025_10k", "layer": "Science", "metric_codes": ["science_to_application_linkage"], "fact_type": "raw_observation", "fact": "R&D spending remained high and rose from about $792 million in 2021 to $1.320 billion in 2025, supporting clinical expansion and platform work.", "raw_value": 1319.775, "raw_unit": "USD millions", "period_start": "2021", "period_end": "2025", "company_attributable": true, "field_proxy": false, "quote_or_excerpt": "", "location": "2025 10-K and 2023 10-K statements of operations", "verified": true, "limitations": "R&D is company-wide, not split by liver, CNS, metabolic, and manufacturing domains."}, {"evidence_id": "ev_q1_2026", "source_id": "src_q1_2026_release", "layer": "Adoption", "metric_codes": ["revenue_or_booking_evidence", "customer_or_partner_breadth", "repeatability_or_deployment_scale"], "fact_type": "raw_observation", "fact": "Q1 2026 net product revenue reached $1.036 billion, up 121% year over year; total TTR revenue reached $910 million, up 153%. 2026 product revenue guidance was $4.9-$5.3 billion.", "raw_value": 1036.127, "raw_unit": "USD millions Q1 net product revenue", "period_start": "2026-Q1", "period_end": "2026-Q1", "company_attributable": true, "field_proxy": false, "quote_or_excerpt": "over $1 billion in quarterly product revenues", "location": "Q1 2026 press release revenue summary", "verified": true, "limitations": "Guidance is forward-looking and not counted as realized adoption."}, {"evidence_id": "ev_pipeline_scope", "source_id": "src_pipeline_2026", "layer": "Industrialization", "metric_codes": ["operational_scale_signal"], "fact_type": "raw_observation", "fact": "The February 2026 pipeline listed commercial RNAi products and active clinical programs across TTR, cardiovascular, metabolic, neuroscience, hematology, rare disease, and other areas.", "raw_value": 20, "raw_unit": "clinical programs approximately", "period_start": "2026", "period_end": "2026", "company_attributable": true, "field_proxy": false, "quote_or_excerpt": "", "location": "Pipeline page", "verified": true, "limitations": "The pipeline page does not provide per-program probability of success."}, {"evidence_id": "ev_delivery_platforms", "source_id": "src_delivery_platforms", "layer": "Science", "metric_codes": ["science_to_application_linkage"], "fact_type": "raw_observation", "fact": "Alnylam discloses LNP delivery, GalNAc conjugates for liver delivery, and C16 conjugates for CNS, lung, and eye delivery; GIVLAARI, OXLUMO, AMVUTTRA and Leqvio use GalNAc conjugate delivery.", "raw_value": 3, "raw_unit": "delivery approaches", "period_start": "2026", "period_end": "2026", "company_attributable": true, "field_proxy": false, "quote_or_excerpt": "LNPs and conjugates", "location": "Delivery Platforms page", "verified": true, "limitations": "Extrahepatic delivery is earlier than the liver platform."}, {"evidence_id": "ev_publication_proxy", "source_id": "src_pubmed_rnai_design", "layer": "Science", "metric_codes": ["publication_growth", "citation_velocity_or_quality"], "fact_type": "search_index_proxy", "fact": "A conservative PubMed/search-index proxy for RNAi therapeutics, GalNAc-siRNA, clinical RNAi, and extrahepatic RNAi returned a rising set of confirmed representative records over 2021-2025: 3, 4, 5, 7, and 9 records. This is a minimum confirmed proxy, not an exhaustive bibliometric census.", "raw_value": 9, "raw_unit": "confirmed representative records", "period_start": "2021", "period_end": "2025", "company_attributable": false, "field_proxy": true, "quote_or_excerpt": "", "location": "PubMed/search-index source set in research run", "verified": true, "limitations": "Counts are minimum confirmed records from accessible search results, not total field publications."}, {"evidence_id": "ev_field_reviews", "source_id": "src_pubmed_rnai_natbiotech", "layer": "Science", "metric_codes": ["citation_velocity_or_quality", "science_to_application_linkage"], "fact_type": "raw_observation", "fact": "Recent reviews in Nature Biotechnology and Nature Reviews Drug Discovery describe RNAi as a clinically validated platform moving from rare diseases to common chronic conditions while highlighting remaining delivery challenges.", "raw_value": 2, "raw_unit": "major reviews", "period_start": "2024", "period_end": "2024", "company_attributable": false, "field_proxy": true, "quote_or_excerpt": "rare diseases to widespread, chronic conditions", "location": "PubMed abstracts", "verified": true, "limitations": "Review articles are synthesis evidence, not a direct count of original discoveries."}, {"evidence_id": "ev_helios_b", "source_id": "src_neJM_helios_b_pubmed", "layer": "Adoption", "metric_codes": ["repeatability_or_deployment_scale"], "fact_type": "raw_observation", "fact": "HELIOS-B randomized 655 ATTR-CM patients to vutrisiran or placebo every 12 weeks for up to 36 months and supported cardiovascular outcome claims used in the AMVUTTRA ATTR-CM approval.", "raw_value": 655, "raw_unit": "patients", "period_start": "2024", "period_end": "2025", "company_attributable": true, "field_proxy": false, "quote_or_excerpt": "", "location": "PubMed abstract and ACC summary", "verified": true, "limitations": "Trial sponsor was Alnylam; post-market comparative effectiveness will take time."}, {"evidence_id": "ev_amvuttra_approval", "source_id": "src_amvuttra_attrcm_approval", "layer": "Policy & Economics", "metric_codes": ["regulatory_or_standards_fit", "economic_readiness"], "fact_type": "raw_observation", "fact": "FDA approved AMVUTTRA for ATTR-CM in March 2025; Alnylam reported HELIOS-B met all 10 prespecified endpoints and that the overall population had a 28% reduction in all-cause mortality and recurrent cardiovascular events during the double-blind period.", "raw_value": 28, "raw_unit": "percent reduction in composite endpoint", "period_start": "2025-03-20", "period_end": "2025-03-20", "company_attributable": true, "field_proxy": false, "quote_or_excerpt": "all 10 pre-specified primary and secondary endpoints", "location": "AMVUTTRA ATTR-CM approval press release", "verified": true, "limitations": "The endpoint statistic is from the company approval release; trial publication and label should be monitored."}, {"evidence_id": "ev_qfitlia_approval", "source_id": "src_fda_qfitlia_approval", "layer": "Policy & Economics", "metric_codes": ["regulatory_or_standards_fit"], "fact_type": "raw_observation", "fact": "FDA approved Qfitlia (fitusiran) in March 2025 for prophylaxis in hemophilia A or B with or without inhibitors; Sanofi describes it as using Alnylam ESC-GalNAc conjugate technology.", "raw_value": 1, "raw_unit": "regulatory approval", "period_start": "2025-03-28", "period_end": "2025-03-28", "company_attributable": true, "field_proxy": false, "quote_or_excerpt": "routine prophylaxis", "location": "FDA press announcement and Sanofi release", "verified": true, "limitations": "Commercial economics accrue mainly through partner royalties rather than Alnylam direct sales."}, {"evidence_id": "ev_patent_proxy", "source_id": "src_justia_assignee", "layer": "IP", "metric_codes": ["patent_family_growth"], "fact_type": "search_index_proxy", "fact": "Public Justia pages show sustained recent Alnylam patent/application flow in RNAi targets, conjugate chemistry, extrahepatic delivery, Reversir, and manufacturing-adjacent chemistry. The visible US publication/grant proxy rises from a low-teens minimum in 2021 to about 50 visible 2025 records across recent pages; this is not an assignee-normalized family export.", "raw_value": 50, "raw_unit": "visible 2025 US records proxy", "period_start": "2021", "period_end": "2025", "company_attributable": true, "field_proxy": false, "quote_or_excerpt": "", "location": "Justia assignee pages, recency sorted", "verified": true, "limitations": "Patent record counts are a public listing proxy, not clean DOCDB/INPADOC family counts."}, {"evidence_id": "ev_patent_specificity", "source_id": "src_justia_assignee", "layer": "IP", "metric_codes": ["technical_specificity", "science_to_patent_or_assignee_quality"], "fact_type": "raw_observation", "fact": "Recent Alnylam patent records include AGT, ANGPTL3, PNPLA3, MAPT, C5, APOC3, TTR, off-target modification, extrahepatic delivery, and Reversir constructs, indicating technical specificity rather than generic platform slogans.", "raw_value": 10, "raw_unit": "representative target/platform families", "period_start": "2024", "period_end": "2026", "company_attributable": true, "field_proxy": false, "quote_or_excerpt": "", "location": "Justia assignee pages", "verified": true, "limitations": "Representative records do not prove patent strength or freedom to operate."}, {"evidence_id": "ev_ttr_family", "source_id": "src_google_ttr_family", "layer": "IP", "metric_codes": ["science_to_patent_or_assignee_quality", "technical_specificity"], "fact_type": "raw_observation", "fact": "The TTR patent family for US12227744B2 includes US plus international records including AU, BR, CA, CN, EP, EA, DK, ES, and HK, showing multi-jurisdictional protection around TTR silencing.", "raw_value": 9, "raw_unit": "jurisdiction groups visible", "period_start": "2025", "period_end": "2025", "company_attributable": true, "field_proxy": false, "quote_or_excerpt": "", "location": "PubChem / Google Patents family metadata", "verified": true, "limitations": "Family membership and legal status need specialist patent counsel verification."}, {"evidence_id": "ev_cns_patent", "source_id": "src_google_cns_patent", "layer": "IP", "metric_codes": ["technical_specificity", "science_to_patent_or_assignee_quality"], "fact_type": "raw_observation", "fact": "WO2023010134A1 covers peptide ligands for CNS and ocular RNAi delivery, with PCT, US, and EP priority links and LRP1-related CNS/ocular delivery concepts.", "raw_value": 3, "raw_unit": "jurisdiction routes", "period_start": "2021", "period_end": "2025", "company_attributable": true, "field_proxy": false, "quote_or_excerpt": "", "location": "Google Patents", "verified": true, "limitations": "CNS delivery patenting does not yet equal commercial delivery validation."}, {"evidence_id": "ev_sirelis", "source_id": "src_sirelis_expansion", "layer": "Industrialization", "metric_codes": ["manufacturing_or_deployment_evidence", "process_learning_or_capex", "operational_scale_signal"], "fact_type": "raw_observation", "fact": "Alnylam announced a $250 million Norton expansion to add siRELIS enzymatic ligation capacity; the 200,000 sq ft site opened in 2021 and produces clinical and commercial siRNA drug substance. The platform had produced pilot-scale batches of zilebesiran and nucresiran.", "raw_value": 250, "raw_unit": "USD millions planned investment", "period_start": "2025-12-17", "period_end": "2025-12-17", "company_attributable": true, "field_proxy": false, "quote_or_excerpt": "pilot-scale batches of zilebesiran and nucresiran", "location": "siRELIS press release", "verified": true, "limitations": "The expansion is planned; yield, cycle time, and cost curves are not disclosed."}, {"evidence_id": "ev_capex", "source_id": "src_sec_2025_10k", "layer": "Industrialization", "metric_codes": ["process_learning_or_capex", "operational_scale_signal"], "fact_type": "raw_observation", "fact": "Capital expenditures were $58.7 million in 2025 and $34.3 million in 2024; Alnylam expected capex to increase in 2026 to support manufacturing and production capacity needs.", "raw_value": 58.7, "raw_unit": "USD millions 2025 capex", "period_start": "2024", "period_end": "2026", "company_attributable": true, "field_proxy": false, "quote_or_excerpt": "support the increase in our manufacturing and production capacity needs", "location": "2025 10-K Additional Capital Requirements", "verified": true, "limitations": "Capex is not broken out by product or platform."}, {"evidence_id": "ev_manufacturing_scope", "source_id": "src_making_medicines", "layer": "Industrialization", "metric_codes": ["manufacturing_or_deployment_evidence", "operational_scale_signal"], "fact_type": "raw_observation", "fact": "Alnylam states that technical operations and manufacturing support all commercial and investigational medicines worldwide and over two dozen active clinical trials at any given time.", "raw_value": 24, "raw_unit": "active clinical trials approximate", "period_start": "2026", "period_end": "2026", "company_attributable": true, "field_proxy": false, "quote_or_excerpt": "over two dozen active clinical trials", "location": "Making Our Medicines page", "verified": true, "limitations": "Company page does not disclose capacity utilization."}, {"evidence_id": "ev_ecosystem_collaborations", "source_id": "src_q1_2026_release", "layer": "Adoption", "metric_codes": ["customer_or_partner_breadth"], "fact_type": "raw_observation", "fact": "Q1 2026 disclosures described collaborations and partner economics with Roche, Regeneron, Novartis, Viz.ai, AHA, and Helix, alongside continued Leqvio royalties.", "raw_value": 6, "raw_unit": "named ecosystem partners", "period_start": "2026-Q1", "period_end": "2026-Q1", "company_attributable": true, "field_proxy": false, "quote_or_excerpt": "", "location": "Q1 2026 release", "verified": true, "limitations": "Partnership breadth is not equivalent to direct product adoption."}, {"evidence_id": "ev_policy_support", "source_id": "src_fda_etp", "layer": "Policy & Economics", "metric_codes": ["policy_or_supply_chain_support", "regulatory_or_standards_fit"], "fact_type": "raw_observation", "fact": "FDA's Emerging Technology Program supports early engagement on innovative pharmaceutical manufacturing technologies; Alnylam disclosed siRELIS acceptance into this program.", "raw_value": 1, "raw_unit": "program acceptance", "period_start": "2025", "period_end": "2026", "company_attributable": true, "field_proxy": false, "quote_or_excerpt": "identify and resolve roadblocks to technology implementation", "location": "FDA ETP page and Alnylam siRELIS release", "verified": true, "limitations": "ETP acceptance is helpful but not a manufacturing approval."}, {"evidence_id": "ev_economic_constraints", "source_id": "src_sec_2025_10k", "layer": "Policy & Economics", "metric_codes": ["economic_readiness"], "fact_type": "raw_observation", "fact": "Alnylam disclosed 2025 cost of goods sold at 22.7% of net product revenue, $1.01 billion convertible debt carrying value, $366.3 million operating lease obligations, and ongoing Blackstone-related payments tied to Leqvio, zilebesiran, and vutrisiran economics.", "raw_value": 22.7, "raw_unit": "percent COGS / net product revenue", "period_start": "2025", "period_end": "2025", "company_attributable": true, "field_proxy": false, "quote_or_excerpt": "", "location": "2025 10-K MD&A", "verified": true, "limitations": "The economics are company-level and do not isolate each technology domain."}, {"evidence_id": "ev_university_network", "source_id": "src_pubmed_rnai_design", "layer": "Science", "metric_codes": ["citation_velocity_or_quality", "science_to_application_linkage"], "fact_type": "raw_observation", "fact": "Accessible academic evidence links RNAi/GalNAc/extrahapetic research to UMass Chan, Aarhus University, Uppsala University, Stanford, UCL, Boston University, Brigham and Women's Hospital, Mayo Clinic, and other clinical research centers.", "raw_value": 9, "raw_unit": "institutions", "period_start": "2021", "period_end": "2025", "company_attributable": false, "field_proxy": true, "quote_or_excerpt": "", "location": "PubMed, Nature Index, ACC and trial source set", "verified": true, "limitations": "Institution list is not a full co-authorship network analysis."}, {"evidence_id": "ev_red_flags", "source_id": "src_sec_2025_10k", "layer": "Policy & Economics", "metric_codes": ["economic_readiness"], "fact_type": "risk_observation", "fact": "Key risks include continued dependence on AMVUTTRA/TTR growth, reimbursement and regulatory risks, royalty/collaboration economics, manufacturing scale-up execution, and uncertainty in extrahepatic delivery.", "raw_value": null, "raw_unit": "risk set", "period_start": "2025", "period_end": "2026", "company_attributable": true, "field_proxy": false, "quote_or_excerpt": "", "location": "2025 10-K risk factors and primary company materials", "verified": true, "limitations": "Risk severity is analyst judgment based on disclosed facts."}], "normalization_notes": [{"metric_code": "publication_growth", "rule": "normalize_growth_proxy_with_floor(start, end, years) with qualitative source discount", "reason": "Only a minimum confirmed publication proxy was available."}, {"metric_code": "patent_family_growth", "rule": "normalize_growth_proxy_with_confidence_discount", "reason": "Public patent pages are a record-listing proxy, not family-by-year analytics."}, {"metric_code": "revenue_or_booking_evidence", "rule": "normalize_growth_and_scale using 5-year product revenue and Q1 2026 revenue growth", "reason": "Real product revenue is the strongest adoption signal for commercial RNAi."}, {"metric_code": "manufacturing_or_deployment_evidence", "rule": "normalize_scale_plus_quality", "reason": "Industrialization depends on commercial/clinical manufacturing proof, not only capex dollars."}, {"metric_code": "economic_readiness", "rule": "scale_adjusted_for_burdens", "reason": "Revenue scale is tempered by royalties, COGS, debt, and reimbursement risks."}], "dashboard_content": {"hero": {"headline": "Alnylam Pharmaceuticals", "subheadline": "Single-company innovation readiness assessment for RNAi translation across liver-targeted therapeutics, extrahepatic delivery, and siRNA manufacturing, based on evidence available on 2026-05-12.", "verdict_label": "Exceptional innovator and plausible scale-up candidate", "evidence_ids": ["ev_company_scale_2025", "ev_q1_2026", "ev_sirelis"], "source_ids": ["src_sec_2025_10k", "src_q1_2026_release", "src_sirelis_expansion"]}, "thesis": {"title": "Thesis", "summary": "Alnylam is one of the few platform biotechs where the science, IP, manufacturing system, and adoption evidence all reinforce each other. The main caveat is concentration in TTR/AMVUTTRA and the still-unproven commercial scale of extrahepatic delivery.", "bullets": [{"text": "The commercial RNAi platform is validated: six marketed products, four direct Alnylam products, two partner-commercialized products, and Q1 2026 net product revenue above $1.0 billion.", "claim_ids": ["claim_commercial_scale"], "evidence_ids": ["ev_company_scale_2025", "ev_q1_2026"], "source_ids": ["src_sec_2025_10k", "src_q1_2026_release"]}, {"text": "AMVUTTRA's ATTR-CM approval converted pivotal science into a large adoption curve and gave Alnylam a durable TTR franchise to fund the next platform wave.", "claim_ids": ["claim_attrcm_adoption"], "evidence_ids": ["ev_amvuttra_approval", "ev_q1_2026"], "source_ids": ["src_amvuttra_attrcm_approval", "src_q1_2026_release"]}, {"text": "The next innovation step is less about proving RNAi works in the liver and more about lowering siRNA manufacturing cost while extending delivery beyond hepatocytes.", "claim_ids": ["claim_next_platform"], "evidence_ids": ["ev_delivery_platforms", "ev_sirelis", "ev_cns_patent"], "source_ids": ["src_delivery_platforms", "src_sirelis_expansion", "src_google_cns_patent"]}, {"text": "The score is high, but not risk-free: reimbursement, royalty obligations, trial execution, manufacturing scale-up, and extrahepatic delivery remain watch items.", "claim_ids": ["claim_red_flags"], "evidence_ids": ["ev_red_flags", "ev_economic_constraints"], "source_ids": ["src_sec_2025_10k"]}]}, "technology_map": {"title": "Technology Map", "summary": "The material innovation domains are the commercial liver-targeted RNAi platform, the extrahepatic delivery expansion, and the siRELIS manufacturing scale-up.", "items": [{"name": "Liver-targeted RNAi and TTR franchise", "description": "GalNAc-conjugated siRNA and LNP roots support approved products including AMVUTTRA, GIVLAARI, OXLUMO and partner products. The TTR franchise is the main commercial engine.", "maturity": "commercial", "evidence_ids": ["ev_delivery_platforms", "ev_company_scale_2025", "ev_q1_2026"], "source_ids": ["src_delivery_platforms", "src_sec_2025_10k", "src_q1_2026_release"]}, {"name": "Extrahepatic RNAi delivery", "description": "C16 and peptide-ligand work targets CNS, eye, lung and newer tissue expansion. This is strategically important but less commercially validated than liver delivery.", "maturity": "pilot", "evidence_ids": ["ev_delivery_platforms", "ev_cns_patent", "ev_pipeline_scope"], "source_ids": ["src_delivery_platforms", "src_google_cns_patent", "src_pipeline_2026"]}, {"name": "siRELIS enzymatic ligation manufacturing", "description": "The Norton expansion is intended to raise siRNA capacity and reduce production cost, with pilot-scale batches of zilebesiran and nucresiran already disclosed.", "maturity": "scaling", "evidence_ids": ["ev_sirelis", "ev_capex"], "source_ids": ["src_sirelis_expansion", "src_sec_2025_10k"]}]}, "quantitative_signals": {"title": "Quantitative Signals", "summary": "The strongest hard data are revenue and R&D intensity. Publication and patent data are shown as auditable public-source proxies rather than exhaustive bibliometric or patent-family exports.", "charts": [{"chart_id": "chart_product_revenue", "title": "Net Product Revenue", "description": "Company product revenue grew about 4.5x from 2021 to 2025.", "series": [{"label": "Net product revenue", "unit": "USD millions", "points": [{"period": "2021", "value": 662}, {"period": "2022", "value": 894}, {"period": "2023", "value": 1241}, {"period": "2024", "value": 1646}, {"period": "2025", "value": 2987}]}], "evidence_ids": ["ev_revenue_trend"], "source_ids": ["src_sec_2025_10k", "src_sec_2023_10k"]}, {"chart_id": "chart_rd_spend", "title": "R&D Spending", "description": "R&D intensity stayed high while the company crossed into profitability.", "series": [{"label": "R&D expense", "unit": "USD millions", "points": [{"period": "2021", "value": 792}, {"period": "2022", "value": 883}, {"period": "2023", "value": 1004}, {"period": "2024", "value": 1126}, {"period": "2025", "value": 1320}]}], "evidence_ids": ["ev_rd_trend"], "source_ids": ["src_sec_2025_10k", "src_sec_2023_10k"]}, {"chart_id": "chart_publication_proxy", "title": "Publication Proxy", "description": "Minimum confirmed PubMed/search-index records for RNAi/GalNAc/extrahepatic RNAi sources; not exhaustive.", "series": [{"label": "Confirmed records", "unit": "records", "points": [{"period": "2021", "value": 3}, {"period": "2022", "value": 4}, {"period": "2023", "value": 5}, {"period": "2024", "value": 7}, {"period": "2025", "value": 9}]}], "evidence_ids": ["ev_publication_proxy", "ev_field_reviews"], "source_ids": ["src_pubmed_rnai_design", "src_pubmed_rnai_natbiotech", "src_pubmed_systematic_2023"]}, {"chart_id": "chart_patent_proxy", "title": "Patent Listing Proxy", "description": "Visible US grant/application proxy from public patent pages; not an INPADOC family count.", "series": [{"label": "Public records proxy", "unit": "records", "points": [{"period": "2021", "value": 16}, {"period": "2022", "value": 22}, {"period": "2023", "value": 31}, {"period": "2024", "value": 43}, {"period": "2025", "value": 50}]}], "evidence_ids": ["ev_patent_proxy"], "source_ids": ["src_justia_assignee"]}]}, "commercialization_evidence": {"title": "Commercialization Evidence", "summary": "Commercial traction is not speculative; it shows up in launches, revenue, regulatory wins, partner products, and manufacturing expansion.", "items": [{"label": "Q1 2026 product revenue", "text": "Net product revenue was $1.036 billion in Q1 2026, up 121% year over year; total TTR revenue was $910 million, up 153%.", "evidence_ids": ["ev_q1_2026"], "source_ids": ["src_q1_2026_release"]}, {"label": "2025 product revenue", "text": "Full-year 2025 net product revenue was about $2.987 billion, up from $1.646 billion in 2024.", "evidence_ids": ["ev_company_scale_2025", "ev_revenue_trend"], "source_ids": ["src_sec_2025_10k"]}, {"label": "Manufacturing scale-up", "text": "Alnylam disclosed a $250 million Norton expansion and FDA ETP acceptance for siRELIS enzymatic ligation manufacturing.", "evidence_ids": ["ev_sirelis", "ev_policy_support"], "source_ids": ["src_sirelis_expansion", "src_fda_etp"]}, {"label": "Partner products", "text": "Leqvio and Qfitlia extend RNAi adoption through Novartis and Sanofi, even though economics flow to Alnylam mainly through royalties and milestones.", "evidence_ids": ["ev_ecosystem_collaborations", "ev_qfitlia_approval"], "source_ids": ["src_q1_2026_release", "src_fda_qfitlia_approval", "src_sanofi_qfitlia"]}]}, "breakthrough_gate": {"title": "Breakthrough Gate", "summary": "The gate passes because industrialization and adoption both clear 3.0 with adequate confidence. The highest residual uncertainty is not whether liver RNAi can commercialize; it is whether the next tissue and manufacturing layers compound as expected.", "conditions_met": [{"condition": "Industrialization is above 3.0 with high coverage, supported by Norton manufacturing, siRELIS, capex and clinical/commercial supply evidence.", "evidence_ids": ["ev_sirelis", "ev_capex", "ev_manufacturing_scope"], "source_ids": ["src_sirelis_expansion", "src_sec_2025_10k", "src_making_medicines"]}, {"condition": "Adoption is above 3.0 with high coverage, supported by six marketed products and Q1 2026 net product revenue above $1.0 billion.", "evidence_ids": ["ev_company_scale_2025", "ev_q1_2026"], "source_ids": ["src_sec_2025_10k", "src_q1_2026_release"]}, {"condition": "Regulatory fit is visible through AMVUTTRA ATTR-CM and Qfitlia approvals plus FDA ETP engagement for siRELIS.", "evidence_ids": ["ev_amvuttra_approval", "ev_qfitlia_approval", "ev_policy_support"], "source_ids": ["src_amvuttra_attrcm_approval", "src_fda_qfitlia_approval", "src_fda_etp"]}], "conditions_not_met": [{"condition": "A clean open patent-family census and complete citation network were unavailable; IP and science confidence are therefore below maximum.", "evidence_ids": ["ev_patent_proxy", "ev_publication_proxy"], "source_ids": ["src_justia_assignee", "src_pubmed_rnai_design"]}, {"condition": "Extrahepatic delivery is not yet commercially validated at the level of the GalNAc liver platform.", "evidence_ids": ["ev_delivery_platforms", "ev_cns_patent"], "source_ids": ["src_delivery_platforms", "src_google_cns_patent"]}], "result": "Pass"}, "university_research_signals": {"title": "University Research", "summary": "The academic signal is broad enough to matter, but the strongest near-term company value signal comes from clinical and manufacturing translation rather than pure paper growth.", "institutions": [{"name": "University of Massachusetts Chan Medical School", "signal": "RNA Therapeutics Institute authors published a 2024 Nature Reviews Drug Discovery review on RNAi-based drug design and future directions.", "company_attributable": false, "field_proxy": true, "evidence_ids": ["ev_university_network", "ev_field_reviews"], "source_ids": ["src_pubmed_rnai_design"]}, {"name": "Aarhus University", "signal": "A 2023 systematic review of clinical RNAi described 90 published trials and 48 ongoing trials through 2022.", "company_attributable": false, "field_proxy": true, "evidence_ids": ["ev_university_network"], "source_ids": ["src_pubmed_systematic_2023"]}, {"name": "Uppsala University", "signal": "2025 PBPK-PD modeling work on GalNAc-siRNAs provides field-level translational pharmacology evidence.", "company_attributable": false, "field_proxy": true, "evidence_ids": ["ev_university_network"], "source_ids": ["src_pubmed_galnac_pk_2025"]}, {"name": "Stanford University and University College London", "signal": "HELIOS-B author and clinical-center signals include Stanford and UCL-linked investigators in the ATTR-CM clinical evidence base.", "company_attributable": false, "field_proxy": true, "evidence_ids": ["ev_helios_b", "ev_university_network"], "source_ids": ["src_neJM_helios_b_pubmed", "src_acc_helios_b"]}]}, "patent_signals": {"title": "Patents", "summary": "Representative public records show a live patent estate across disease targets, delivery, chemistry and reversibility. The trend chart is a listing proxy, not a legal family count.", "families": [{"title": "Compositions and methods for inhibiting expression of transthyretin", "publication_or_family_id": "US12227744B2", "jurisdictions": ["US", "EP", "CN", "CA", "AU", "BR", "WO-family metadata"], "priority_date": "2008-10-20", "interpretation": "TTR silencing is the core commercial patent signal behind the TTR franchise and AMVUTTRA/nucresiran domain.", "evidence_ids": ["ev_ttr_family"], "source_ids": ["src_justia_ttr_patent", "src_google_ttr_family"]}, {"title": "Peptide ligands for CNS and ocular delivery of RNAi compounds", "publication_or_family_id": "WO2023010134A1", "jurisdictions": ["WO", "US", "EP"], "priority_date": "2021-07-30", "interpretation": "This is a representative extrahepatic delivery signal tied to CNS/ocular RNAi expansion, not yet a commercial proof point.", "evidence_ids": ["ev_cns_patent"], "source_ids": ["src_google_cns_patent"]}, {"title": "REVERSIR compounds", "publication_or_family_id": "US12241064B2", "jurisdictions": ["US"], "priority_date": "2021-08-10", "interpretation": "Reversir patents matter because reversibility can improve safety and controllability for potent, durable siRNA medicines.", "evidence_ids": ["ev_patent_specificity"], "source_ids": ["src_justia_assignee"]}, {"title": "Angiotensinogen iRNA compositions and methods of use", "publication_or_family_id": "US12584130B2", "jurisdictions": ["US"], "priority_date": "2023-10-24", "interpretation": "AGT patenting aligns with zilebesiran and the move from rare genetic disease toward large cardiometabolic markets.", "evidence_ids": ["ev_patent_specificity"], "source_ids": ["src_justia_assignee"]}], "interpretation": "The IP layer is strong on specificity and assignee quality, but the absence of a full reproducible patent-family export prevents maximum confidence."}, "red_flags": [{"red_flag_id": "rf_ttr_concentration", "title": "TTR concentration", "text": "AMVUTTRA and the TTR franchise dominate the current adoption signal; a slowdown in ATTR-CM penetration, payer support or competitive dynamics would matter disproportionately.", "severity": "medium", "layer": "Adoption", "evidence_ids": ["ev_q1_2026", "ev_red_flags"], "source_ids": ["src_q1_2026_release", "src_sec_2025_10k"], "claim_ids": ["claim_red_flags"]}, {"red_flag_id": "rf_extrahepatic", "title": "Extrahepatic delivery gap", "text": "CNS, ocular, adipose and other non-liver delivery programs are strategically important, but the commercial validation level is far below the GalNAc liver platform.", "severity": "medium", "layer": "Science", "evidence_ids": ["ev_delivery_platforms", "ev_cns_patent", "ev_red_flags"], "source_ids": ["src_delivery_platforms", "src_google_cns_patent", "src_sec_2025_10k"], "claim_ids": ["claim_red_flags"]}, {"red_flag_id": "rf_manufacturing", "title": "Manufacturing execution", "text": "siRELIS is a credible scale-up lever, but public sources do not yet show commercial yield, cost, cycle-time or validation data.", "severity": "medium", "layer": "Industrialization", "evidence_ids": ["ev_sirelis", "ev_capex", "ev_red_flags"], "source_ids": ["src_sirelis_expansion", "src_sec_2025_10k"], "claim_ids": ["claim_red_flags"]}, {"red_flag_id": "rf_economics", "title": "Royalty and financing burdens", "text": "Strong product revenue is partially offset by COGS, blended AMVUTTRA royalty rate pressure, convertible debt and Blackstone-related payment obligations.", "severity": "medium", "layer": "Policy & Economics", "evidence_ids": ["ev_economic_constraints"], "source_ids": ["src_sec_2025_10k"], "claim_ids": ["claim_red_flags"]}], "watchlist": {"title": "What Would Change The View", "upgrade_signals": [{"text": "Nucresiran pivotal data, launch timing, and dosing profile confirm durable TTR leadership beyond AMVUTTRA.", "monitoring_source": "Alnylam filings, trial readouts, FDA/EMA submissions, earnings calls."}, {"text": "siRELIS commercial validation shows lower cost, higher throughput, and smooth CMC acceptance in regulatory submissions.", "monitoring_source": "FDA ETP updates, Alnylam manufacturing disclosures, 10-K capex and COGS trends."}, {"text": "Mivelsiran, ALN-HTT02 or adipose-targeted ALN-2232 produce convincing human target knockdown and safety data.", "monitoring_source": "ClinicalTrials.gov, PubMed, Alnylam RNAi Roundtable, conference abstracts."}], "downgrade_signals": [{"text": "AMVUTTRA demand slows materially versus 2026 TTR guidance or payer friction limits ATTR-CM uptake.", "monitoring_source": "Quarterly revenue, payer coverage disclosures, earnings calls."}, {"text": "Zilebesiran or nucresiran trials miss outcome endpoints or show tolerability issues that weaken the large-market expansion thesis.", "monitoring_source": "Phase 3 results, FDA communications, peer-reviewed clinical publications."}, {"text": "Extrahepatic programs fail to show tissue delivery, target knockdown, or acceptable safety margins in humans.", "monitoring_source": "Clinical trial readouts, conference presentations, regulatory holds."}], "cadence": [{"frequency": "quarterly", "task": "Refresh product revenue, TTR guidance, R&D, capex, pipeline milestones, regulatory events, and patent/publication proxies."}, {"frequency": "semiannual", "task": "Rebuild patent and publication maps with a paid or exportable family/scientometric database if peer benchmarking is requested."}]}, "operational_snapshot": {"title": "Operational Snapshot", "metrics": [{"label": "Q1 2026 net product revenue", "value": "$1.036B", "period": "2026-Q1", "evidence_ids": ["ev_q1_2026"], "source_ids": ["src_q1_2026_release"]}, {"label": "Q1 2026 total TTR revenue", "value": "$910M", "period": "2026-Q1", "evidence_ids": ["ev_q1_2026"], "source_ids": ["src_q1_2026_release"]}, {"label": "2026 product revenue guidance", "value": "$4.9B-$5.3B", "period": "2026", "evidence_ids": ["ev_q1_2026"], "source_ids": ["src_q1_2026_release"]}, {"label": "2025 R&D expense", "value": "$1.320B", "period": "2025", "evidence_ids": ["ev_rd_trend"], "source_ids": ["src_sec_2025_10k"]}, {"label": "Norton expansion", "value": "$250M planned", "period": "2025-2026", "evidence_ids": ["ev_sirelis"], "source_ids": ["src_sirelis_expansion"]}, {"label": "Marketed RNAi products", "value": "6 including partners", "period": "2025", "evidence_ids": ["ev_company_scale_2025"], "source_ids": ["src_sec_2025_10k"]}]}, "method_notes": {"title": "Method Notes", "notes": ["This is a single-company absolute readiness score. No peer percentile or relative ranking was created.", "The deterministic scorer computes each layer from normalized 0..1 metrics, applies a coverage confidence penalty, and maps the total to the verdict.", "Patent and publication time series are public-source proxies because clean exportable patent-family and scientometric databases were unavailable in this run.", "All dashboard-visible company-specific claims are housed in payload.json and preserved in scored.json; the dashboard renderer reads scored.json."]}, "bottom_line": {"title": "Bottom Line", "text": "Alnylam qualifies as an exceptional innovator on absolute readiness: RNAi science has become approved medicine, adoption is scaling, and manufacturing is moving into a new cost/capacity phase. The next proof point is whether siRELIS and extrahepatic delivery can turn today's TTR-led success into a broader, lower-cost RNAi platform.", "claim_ids": ["claim_bottom_line"], "evidence_ids": ["ev_company_scale_2025", "ev_q1_2026", "ev_sirelis", "ev_delivery_platforms"], "source_ids": ["src_sec_2025_10k", "src_q1_2026_release", "src_sirelis_expansion", "src_delivery_platforms"]}}, "claims": [{"claim_id": "claim_commercial_scale", "section": "thesis", "text": "Alnylam has reached commercial RNAi scale with six marketed products and more than $1.0 billion in Q1 2026 net product revenue.", "claim_type": "sourced_fact", "confidence": "High", "evidence_ids": ["ev_company_scale_2025", "ev_q1_2026"], "source_ids": ["src_sec_2025_10k", "src_q1_2026_release"]}, {"claim_id": "claim_attrcm_adoption", "section": "thesis", "text": "AMVUTTRA's ATTR-CM approval an