            "search_log": [
                {"query": "Alnylam 2025 10-K SEC RNAi product revenue R&D", "source": "web_search", "date": "2026-05-12", "result_quality": "high", "selected": True, "selection_reason": "Primary filing."},
                {"query": "Alnylam Q1 2026 results AMVUTTRA total TTR net product revenue", "source": "web_search", "date": "2026-05-12", "result_quality": "high", "selected": True, "selection_reason": "Latest company operating disclosure."},
                {"query": "Alnylam RNAi delivery platforms GalNAc C16 CNS", "source": "web_search", "date": "2026-05-12", "result_quality": "high", "selected": True, "selection_reason": "Primary platform description."},
                {"query": "Alnylam siRELIS FDA Emerging Technology Program Norton expansion", "source": "web_search", "date": "2026-05-12", "result_quality": "high", "selected": True, "selection_reason": "Primary industrialization evidence."},
                {"query": "Patents assigned to Alnylam Pharmaceuticals Justia 2025 RNAi GalNAc", "source": "web_search", "date": "2026-05-12", "result_quality": "medium", "selected": True, "selection_reason": "Representative public patent listing."},
                {"query": "RNAi therapeutics GalNAc PubMed 2021 2025 university review", "source": "web_search", "date": "2026-05-12", "result_quality": "medium", "selected": True, "selection_reason": "Field-level publication proxy and university signals."},
