+      padding: 22px;
+      border-radius: 6px;
+    }
+
+    .score-line {
+      display: flex;
+      align-items: baseline;
+      gap: 10px;
+      color: var(--burgundy);
+    }
+
+    .score-number {
+      font-size: clamp(58px, 8vw, 86px);
+      line-height: 0.9;
+      font-weight: 900;
+    }
+
