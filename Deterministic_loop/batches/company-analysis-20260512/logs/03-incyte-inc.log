+      border-radius: 5px;
+      color: var(--burgundy);
+      background: rgba(212, 165, 165, 0.16);
+      font-size: 12px;
+      font-weight: 800;
+      margin-top: 10px;
+    }
+
+    .chart {
+      display: grid;
+      gap: 10px;
+    }
+
+    .chart-title {
+      display: flex;
+      justify-content: space-between;
+      gap: 10px;
+      color: var(--burgundy);
+      font-weight: 900;
+    }
+
+    .bars {
+      display: grid;
+      gap: 8px;
+      margin-top: 5px;
