+      font-size: 13px;
+    }
+
+    .topbar strong { color: var(--burgundy); }
+
+    .hero {
+      padding: 42px 0 34px;
+      display: grid;
+      grid-template-columns: minmax(0, 1fr) minmax(280px, 360px);
+      gap: 40px;
+      align-items: end;
+    }
+
+    .eyebrow {
+      color: var(--clay);
+      font-size: 12px;
+      font-weight: 800;
+      text-transform: uppercase;
+      letter-spacing: 0;
+    }
+
+    h1, h2, h3 {
+      margin: 0;
+      color: var(--burgundy);
+      font-family: FreeSans, Arial, Helvetica, sans-serif;
+      letter-spacing: 0;
+    }
+
+    h1 {
+      margin-top: 12px;
+      max-width: 870px;
+      font-size: clamp(38px, 6vw, 76px);
+      line-height: 0.96;
+    }
+
+    h2 {
+      font-size: clamp(24px, 3vw, 38px);
+      line-height: 1.08;
+    }
+
+    h3 {
+      font-size: 16px;
+      line-height: 1.2;
+    }
+
+    p { margin: 0; color: var(--muted); }
+
+    .subhead {
+      margin-top: 18px;
+      max-width: 760px;
+      font-size: 17px;
+    }
+
+    .score-panel {
+      border: 1px solid var(--line);
+      background: rgba(255, 248, 243, 0.74);
+      box-shadow: var(--shadow);
+      padding: 22px;
+      border-radius: 6px;
+    }
+
+    .score-line {
+      display: flex;
+      align-items: baseline;
+      gap: 10px;
+      color: var(--burgundy);
+    }
+
+    .score-number {
+      font-size: clamp(58px, 8vw, 86px);
+      line-height: 0.9;
+      font-weight: 900;
+    }
+
+    .score-total {
+      color: var(--muted);
+      font-weight: 800;
+    }
+
+    .verdict {
+      margin-top: 12px;
+      color: var(--ink);
+      font-weight: 800;
+    }
+
+    .status-row {
+      display: flex;
+      flex-wrap: wrap;
+      gap: 8px;
+      margin-top: 16px;
+    }
+
+    .status {
+      display: inline-flex;
+      align-items: center;
+      min-height: 28px;
+      padding: 5px 9px;
+      border-radius: 6px;
+      border: 1px solid var(--line);
+      background: rgba(212, 165, 165, 0.18);
+      color: var(--burgundy);
+      font-size: 12px;
+      font-weight: 800;
+    }
+
+    main { padding: 10px 0 78px; }
+
+    section {
+      padding: 38px 0;
+      border-top: 1px solid var(--line);
+    }
+
+    .section-head {
+      display: grid;
+      grid-template-columns: 270px minmax(0, 1fr);
+      gap: 28px;
+      margin-bottom: 24px;
+      align-items: start;
+    }
+
+    .section-head p { max-width: 840px; }
+
+    .muted { color: var(--muted); }
+    .small { font-size: 13px; }
+
+    .stack {
+      display: grid;
+      gap: 14px;
+    }
+
+    .layer-row,
+    .panel {
+      border: 1px solid var(--line);
+      background: var(--field);
+      border-radius: 6px;
+    }
+
+    .layer-row {
+      padding: 18px;
+      transition: transform 180ms ease, border-color 180ms ease, background 180ms ease;
+      animation: rise 520ms ease both;
+    }
+
+    .layer-row:hover {
+      transform: translateY(-2px);
+      border-color: rgba(184, 125, 109, 0.58);
+      background: rgba(255, 248, 243, 0.88);
+    }
+
+    .layer-top {
+      display: grid;
+      grid-template-columns: 190px minmax(0, 1fr) 78px;
+      gap: 16px;
+      align-items: center;
+    }
+
+    .bar-track {
+      height: 8px;
+      background: rgba(93, 46, 70, 0.14);
+      border-radius: 999px;
+      overflow: hidden;
+      position: relative;
+    }
+
+    .bar-fill {
+      height: 100%;
+      width: 0%;
+      border-radius: inherit;
+      background: linear-gradient(90deg, var(--clay), var(--dusty-rose));
+      box-shadow: 0 0 16px rgba(184, 125, 109, 0.26);
+      transition: width 900ms cubic-bezier(.2, .8, .2, 1);
+    }
+
+    .layer-score {
+      color: var(--burgundy);
+      font-weight: 900;
+      text-align: right;
+      white-space: nowrap;
+    }
+
+    .layer-copy {
+      display: grid;
+      grid-template-columns: 1fr 1fr 0.72fr;
