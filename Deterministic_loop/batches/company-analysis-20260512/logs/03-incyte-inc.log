index 0000000000000000000000000000000000000000..9344f7765ed0e882a626fb86a624cb50ec55e730
--- /dev/null
+++ b/scripts/build_innovation_dashboard.mjs
@@ -0,0 +1,854 @@
+import { readFileSync, writeFileSync } from "node:fs";
+
+const [scoredPath, outputPath] = process.argv.slice(2);
+
+if (!scoredPath || !outputPath) {
+  console.error("Usage: node scripts/build_innovation_dashboard.mjs <scored.json> <dashboard.html>");
+  process.exit(1);
+}
+
+const scored = JSON.parse(readFileSync(scoredPath, "utf8"));
+const embedded = JSON.stringify(scored, null, 2).replace(/</g, "\\u003c");
+
+const html = `<!doctype html>
+<html lang="en">
+<head>
+  <meta charset="utf-8">
+  <meta name="viewport" content="width=device-width, initial-scale=1">
+  <title>Innovation Readiness Dashboard</title>
+  <style>
+    :root {
+      --dusty-rose: #d4a5a5;
+      --clay: #b87d6d;
+      --sand: #e8d5c4;
+      --burgundy: #5d2e46;
+      --paper: #fff8f3;
+      --ink: #261820;
+      --muted: #735d64;
+      --line: rgba(93, 46, 70, 0.18);
+      --line-strong: rgba(93, 46, 70, 0.32);
+      --field: rgba(255, 248, 243, 0.72);
+      --steel: #536b70;
+      --olive: #667553;
+      --warn: #9c5c42;
+      --shadow: 0 18px 52px rgba(93, 46, 70, 0.12);
+    }
+
+    * { box-sizing: border-box; }
+    html { scroll-behavior: smooth; }
+    body {
+      margin: 0;
+      min-width: 320px;
+      color: var(--ink);
+      background: linear-gradient(180deg, #fff8f3 0%, #f4e4dc 42%, var(--sand) 100%);
+      font-family: FreeSans, Arial, Helvetica, sans-serif;
+      line-height: 1.45;
+    }
+
+    a { color: var(--burgundy); text-decoration: none; }
+    a:hover { text-decoration: underline; }
+    button, input, select, textarea { font: inherit; }
+
+    .shell {
+      width: min(1180px, calc(100vw - 36px));
+      margin: 0 auto;
+    }
+
+    .topbar {
+      display: flex;
+      justify-content: space-between;
+      gap: 16px;
+      align-items: center;
+      padding: 18px 0;
+      border-bottom: 1px solid var(--line);
+      color: var(--muted);
+      font-size: 13px;
+    }
+
+    .topbar strong { color: var(--burgundy); }
+
+    .hero {
+      padding: 42px 0 34px;
+      display: grid;
+      grid-template-columns: minmax(0, 1fr) minmax(280px, 360px);
+      gap: 40px;
+      align-items: end;
+    }
+
+    .eyebrow {
+      color: var(--clay);
+      font-size: 12px;
+      font-weight: 800;
+      text-transform: uppercase;
+      letter-spacing: 0;
+    }
+
+    h1, h2, h3 {
+      margin: 0;
+      color: var(--burgundy);
+      font-family: FreeSans, Arial, Helvetica, sans-serif;
+      letter-spacing: 0;
+    }
+
+    h1 {
+      margin-top: 12px;
+      max-width: 870px;
+      font-size: clamp(38px, 6vw, 76px);
+      line-height: 0.96;
+    }
+
+    h2 {
+      font-size: clamp(24px, 3vw, 38px);
+      line-height: 1.08;
+    }
+
+    h3 {
+      font-size: 16px;
+      line-height: 1.2;
+    }
+
+    p { margin: 0; color: var(--muted); }
+
+    .subhead {
+      margin-top: 18px;
+      max-width: 760px;
+      font-size: 17px;
+    }
+
+    .score-panel {
+      border: 1px solid var(--line);
+      background: rgba(255, 248, 243, 0.74);
+      box-shadow: var(--shadow);
+      padding: 22px;
+      border-radius: 6px;
+    }
+
+    .score-line {
+      display: flex;
+      align-items: baseline;
+      gap: 10px;
+      color: var(--burgundy);
+    }
+
+    .score-number {
+      font-size: clamp(58px, 8vw, 86px);
+      line-height: 0.9;
+      font-weight: 900;
+    }
+
+    .score-total {
+      color: var(--muted);
+      font-weight: 800;
+    }
+
+    .verdict {
+      margin-top: 12px;
+      color: var(--ink);
+      font-weight: 800;
+    }
+
+    .status-row {
+      display: flex;
+      flex-wrap: wrap;
+      gap: 8px;
+      margin-top: 16px;
+    }
+
+    .status {
+      display: inline-flex;
+      align-items: center;
+      min-height: 28px;
+      padding: 5px 9px;
+      border-radius: 6px;
+      border: 1px solid var(--line);
+      background: rgba(212, 165, 165, 0.18);
+      color: var(--burgundy);
+      font-size: 12px;
+      font-weight: 800;
+    }
+
+    main { padding: 10px 0 78px; }
+
+    section {
+      padding: 38px 0;
+      border-top: 1px solid var(--line);
+    }
+
+    .section-head {
+      display: grid;
+      grid-template-columns: 270px minmax(0, 1fr);
+      gap: 28px;
+      margin-bottom: 24px;
+      align-items: start;
+    }
+
+    .section-head p { max-width: 840px; }
+
+    .muted { color: var(--muted); }
+    .small { font-size: 13px; }
+
+    .stack {
+      display: grid;
+      gap: 14px;
+    }
+
+    .layer-row,
+    .panel {
+      border: 1px solid var(--line);
+      background: var(--field);
+      border-radius: 6px;
+    }
+
+    .layer-row {
+      padding: 18px;
+      transition: transform 180ms ease, border-color 180ms ease, background 180ms ease;
+      animation: rise 520ms ease both;
+    }
+
+    .layer-row:hover {
+      transform: translateY(-2px);
+      border-color: rgba(184, 125, 109, 0.58);
+      background: rgba(255, 248, 243, 0.88);
+    }
+
+    .layer-top {
+      display: grid;
+      grid-template-columns: 190px minmax(0, 1fr) 78px;
+      gap: 16px;
+      align-items: center;
+    }
+
+    .bar-track {
+      height: 8px;
+      background: rgba(93, 46, 70, 0.14);
+      border-radius: 999px;
+      overflow: hidden;
+      position: relative;
+    }
+
+    .bar-fill {
+      height: 100%;
+      width: 0%;
+      border-radius: inherit;
+      background: linear-gradient(90deg, var(--clay), var(--dusty-rose));
+      box-shadow: 0 0 16px rgba(184, 125, 109, 0.26);
+      transition: width 900ms cubic-bezier(.2, .8, .2, 1);
+    }
+
+    .layer-score {
+      color: var(--burgundy);
+      font-weight: 900;
+      text-align: right;
+      white-space: nowrap;
+    }
+
+    .layer-copy {
+      display: grid;
+      grid-template-columns: 1fr 1fr 0.72fr;
+      gap: 18px;
+      padding-top: 15px;
+      color: var(--muted);
+      font-size: 14px;
+    }
+
+    .mini-label {
+      color: var(--clay);
+      display: block;
+      font-size: 11px;
+      font-weight: 900;
+      text-transform: uppercase;
+      margin-bottom: 4px;
+    }
+
+    .grid-two {
+      display: grid;
+      grid-template-columns: repeat(2, minmax(0, 1fr));
+      gap: 18px;
+    }
+
+    .grid-three {
+      display: grid;
+      grid-template-columns: repeat(3, minmax(0, 1fr));
+      gap: 18px;
+    }
+
+    .panel {
+      padding: 18px;
+      min-height: 100%;
+    }
+
+    .panel h3 { margin-bottom: 8px; }
+
+    .list {
+      list-style: none;
+      padding: 0;
+      margin: 0;
+      display: grid;
+      gap: 13px;
+    }
+
+    .list li {
+      padding-bottom: 13px;
+      border-bottom: 1px solid rgba(93, 46, 70, 0.12);
+    }
+
+    .list li:last-child {
+      padding-bottom: 0;
+      border-bottom: 0;
+    }
+
+    .item-title {
+      color: var(--burgundy);
+      font-weight: 900;
+      margin-bottom: 4px;
+    }
+
+    .tag {
+      display: inline-flex;
+      align-items: center;
+      min-height: 24px;
+      padding: 3px 7px;
+      border: 1px solid var(--line);
+      border-radius: 5px;
+      color: var(--burgundy);
+      background: rgba(212, 165, 165, 0.16);
+      font-size: 12px;
+      font-weight: 800;
+      margin-top: 10px;
+    }
+
+    .chart {
+      display: grid;
+      gap: 10px;
+    }
+
+    .chart-title {
+      display: flex;
+      justify-content: space-between;
+      gap: 10px;
+      color: var(--burgundy);
+      font-weight: 900;
+    }
+
+    .bars {
+      display: grid;
+      gap: 8px;
+      margin-top: 5px;
+    }
+
+    .bar-line {
+      display: grid;
+      grid-template-columns: 74px minmax(0, 1fr) 80px;
+      gap: 10px;
+      align-items: center;
+      color: var(--muted);
+      font-size: 12px;
+    }
+
+    .thin-track {
+      height: 7px;
+      border-radius: 999px;
+      overflow: hidden;
+      background: rgba(93, 46, 70, 0.12);
+    }
+
+    .thin-fill {
+      height: 100%;
+      width: 0%;
+      border-radius: inherit;
+      background: linear-gradient(90deg, var(--steel), var(--olive));
+      transition: width 750ms cubic-bezier(.2, .8, .2, 1);
+    }
+
+    .metrics-grid {
+      display: grid;
+      grid-template-columns: repeat(3, minmax(0, 1fr));
+      gap: 12px;
+    }
+
+    .metric {
+      border-top: 2px solid var(--clay);
+      padding-top: 10px;
+    }
+
+    .metric-value {
+      color: var(--burgundy);
+      font-size: 24px;
+      line-height: 1.05;
+      font-weight: 900;
+      overflow-wrap: anywhere;
+    }
+
+    .metric-label {
+      color: var(--muted);
+      font-size: 12px;
+      font-weight: 800;
+      margin-top: 4px;
+    }
+
+    .source-list {
+      display: grid;
+      gap: 8px;
+      font-size: 13px;
+    }
+
+    .source-row {
+      display: grid;
+      grid-template-columns: 82px minmax(0, 1fr) 92px;
+      gap: 12px;
+      padding: 10px 0;
+      border-bottom: 1px solid rgba(93, 46, 70, 0.12);
+    }
+
+    .source-row:last-child { border-bottom: 0; }
+
+    .refs {
+      margin-top: 10px;
+      color: var(--muted);
+      font-size: 12px;
+    }
+
+    .refs a {
+      display: inline-flex;
+      margin-right: 8px;
+      margin-top: 4px;
+      border-bottom: 1px solid rgba(93, 46, 70, 0.25);
+    }
+
+    .severity-high { border-top-color: #8a3d35; }
+    .severity-medium { border-top-color: var(--warn); }
+    .severity-low { border-top-color: var(--olive); }
+
+    footer {
+      border-top: 1px solid var(--line);
+      padding: 22px 0 34px;
+      color: var(--muted);
+      font-size: 13px;
+    }
+
+    @keyframes rise {
+      from { opacity: 0; transform: translateY(10px); }
+      to { opacity: 1; transform: translateY(0); }
+    }
+
+    @media (max-width: 900px) {
+      .hero,
+      .section-head,
+      .grid-two,
+      .grid-three {
+        grid-template-columns: 1fr;
+      }
+      .hero { gap: 24px; padding-top: 32px; }
+      .metrics-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
+      .layer-copy { grid-template-columns: 1fr; }
+    }
+
+    @media (max-width: 620px) {
+      .shell { width: min(100vw - 24px, 1180px); }
+      .topbar { align-items: flex-start; flex-direction: column; }
+      .layer-top {
+        grid-template-columns: 1fr;
+        gap: 8px;
+      }
+      .layer-score { text-align: left; }
+      .bar-line { grid-template-columns: 54px minmax(0, 1fr) 62px; }
+      .metrics-grid { grid-template-columns: 1fr; }
+      .source-row { grid-template-columns: 1fr; gap: 4px; }
+      h1 { font-size: clamp(36px, 13vw, 58px); }
+    }
+  </style>
+</head>
+<body>
+  <script id="scored-data" type="application/json">${embedded}</script>
+
+  <div class="shell">
+    <div class="topbar">
+      <div><strong id="company-name"></strong> <span id="ticker"></span></div>
+      <div id="run-meta"></div>
+    </div>
+
+    <header class="hero">
+      <div>
+        <div class="eyebrow">Innovation readiness</div>
+        <h1 id="hero-headline"></h1>
+        <p class="subhead" id="hero-subheadline"></p>
+      </div>
+      <aside class="score-panel" aria-label="Score summary">
+        <div class="mini-label">Score</div>
+        <div class="score-line">
+          <div class="score-number" id="total-score"></div>
+          <div class="score-total">/ 25</div>
+        </div>
+        <div class="verdict" id="verdict"></div>
+        <div class="status-row">
+          <span class="status" id="gate-status"></span>
+          <span class="status" id="mode-status"></span>
+        </div>
+      </aside>
+    </header>
+
+    <main>
+      <section>
+        <div class="section-head">
+          <h2>Layer Scores</h2>
+          <p>Five readiness layers are stacked vertically. Each bar is scorer-produced and uses the deterministic confidence penalty from the embedded JSON.</p>
+        </div>
+        <div class="stack" id="layers"></div>
+      </section>
+
+      <section>
+        <div class="section-head">
+          <h2 id="thesis-title"></h2>
+          <p id="thesis-summary"></p>
+        </div>
+        <div class="grid-two" id="thesis-grid"></div>
+      </section>
+
+      <section>
+        <div class="section-head">
+          <h2 id="tech-title"></h2>
+          <p id="tech-summary"></p>
+        </div>
+        <div class="grid-three" id="technology-map"></div>
+      </section>
+
+      <section>
+        <div class="section-head">
+          <h2 id="signals-title"></h2>
+          <p id="signals-summary"></p>
+        </div>
+        <div class="grid-two" id="charts"></div>
+      </section>
+
+      <section>
+        <div class="section-head">
+          <h2 id="commercial-title"></h2>
+          <p id="commercial-summary"></p>
+        </div>
+        <div class="grid-two" id="commercial-grid"></div>
+      </section>
+
+      <section>
+        <div class="section-head">
+          <h2 id="gate-title"></h2>
+          <p id="gate-summary"></p>
+        </div>
+        <div class="grid-two">
+          <div class="panel">
+            <h3>Met</h3>
+            <ul class="list" id="gate-met"></ul>
+          </div>
+          <div class="panel">
+            <h3>Not Met</h3>
+            <ul class="list" id="gate-not-met"></ul>
+          </div>
+        </div>
+      </section>
+
+      <section>
+        <div class="section-head">
+          <h2 id="university-title"></h2>
+          <p id="university-summary"></p>
+        </div>
+        <div class="grid-three" id="universities"></div>
+      </section>
+
+      <section>
+        <div class="section-head">
+          <h2 id="patents-title"></h2>
+          <p id="patents-summary"></p>
+        </div>
+        <div class="grid-two" id="patents"></div>
+      </section>
+
+      <section>
+        <div class="section-head">
+          <h2>Risks</h2>
+          <p>Displayed risks are pulled from the scored payload and retain their linked source and evidence identifiers.</p>
+        </div>
+        <div class="grid-three" id="red-flags"></div>
+      </section>
+
+      <section>
+        <div class="section-head">
+          <h2 id="watch-title"></h2>
+          <p>Upgrade and downgrade triggers define the next evidence refresh.</p>
+        </div>
+        <div class="grid-two">
+          <div class="panel">
+            <h3>Upgrade</h3>
+            <ul class="list" id="upgrade-list"></ul>
+          </div>
+          <div class="panel">
+            <h3>Downgrade</h3>
+            <ul class="list" id="downgrade-list"></ul>
+          </div>
+        </div>
+      </section>
+
+      <section>
+        <div class="section-head">
+          <h2 id="snapshot-title"></h2>
+          <p>Operating scale and late-stage execution indicators from primary disclosures.</p>
+        </div>
+        <div class="metrics-grid" id="snapshot"></div>
+      </section>
+
+      <section>
+        <div class="section-head">
+          <h2 id="method-title"></h2>
+          <p>Scoring notes and data-quality constraints for this single-company run.</p>
+        </div>
+        <div class="panel">
+          <ul class="list" id="method-notes"></ul>
+        </div>
+      </section>
+
+      <section>
+        <div class="section-head">
+          <h2 id="bottom-title"></h2>
+          <p id="bottom-text"></p>
+        </div>
+      </section>
+
+      <section>
+        <div class="section-head">
+          <h2>Sources</h2>
+          <p>Primary, policy, academic, and patent sources used by the scored evidence record.</p>
+        </div>
+        <div class="panel">
+          <div class="source-list" id="sources"></div>
+        </div>
+      </section>
+    </main>
+
+    <footer id="footer"></footer>
+  </div>
+
+  <script>
+    const data = JSON.parse(document.getElementById("scored-data").textContent);
+    const content = data.dashboard_content || {};
+    const sourceMap = new Map((data.sources || []).map((source) => [source.source_id, source]));
+
+    const $ = (id) => document.getElementById(id);
+
+    function text(id, value) {
+      const node = $(id);
+      if (node) node.textContent = value || "";
+    }
+
+    function escapeText(value) {
+      return String(value ?? "");
+    }
+
+    function refs(sourceIds = [], evidenceIds = []) {
+      const sourceLinks = (sourceIds || [])
+        .map((id) => {
+          const source = sourceMap.get(id);
+          if (!source) return "";
+          return '<a href="' + source.url + '" target="_blank" rel="noreferrer">' + id + '</a>';
+        })
+        .join("");
+      const evidence = (evidenceIds || []).map((id) => '<span>' + id + '</span>').join(" ");
+      if (!sourceLinks && !evidence) return "";
+      return '<div class="refs">' + sourceLinks + (evidence ? '<span>' + evidence + '</span>' : "") + '</div>';
+    }
+
+    function panel(titleValue, bodyValue, metaValue, sourceIds, evidenceIds, extraClass = "") {
+      const div = document.createElement("div");
+      div.className = "panel " + extraClass;
+      div.innerHTML =
+        '<h3>' + escapeText(titleValue) + '</h3>' +
+        '<p class="small">' + escapeText(bodyValue) + '</p>' +
+        (metaValue ? '<span class="tag">' + escapeText(metaValue) + '</span>' : "") +
+        refs(sourceIds, evidenceIds);
+      return div;
+    }
+
+    function renderList(node, items, pickText) {
+      node.innerHTML = "";
+      (items || []).forEach((item) => {
+        const li = document.createElement("li");
+        const body = pickText(item);
+        li.innerHTML = '<p class="small">' + escapeText(body) + '</p>' + refs(item.source_ids, item.evidence_ids);
+        node.appendChild(li);
+      });
+    }
+
+    function renderLayers() {
+      const root = $("layers");
+      root.innerHTML = "";
+      (data.layers || []).forEach((layer, index) => {
+        const row = document.createElement("article");
+        row.className = "layer-row";
+        row.style.animationDelay = (index * 70) + "ms";
+        const percent = Math.max(0, Math.min(100, (Number(layer.score) / 5) * 100));
+        row.innerHTML =
+          '<div class="layer-top">' +
+            '<h3>' + escapeText(layer.label) + '</h3>' +
+            '<div class="bar-track" aria-hidden="true"><div class="bar-fill" data-width="' + percent.toFixed(1) + '%"></div></div>' +
+            '<div class="layer-score">' + escapeText(layer.display_score ?? layer.score) + ' / 5</div>' +
+          '</div>' +
+          '<div class="layer-copy">' +
+            '<p><span class="mini-label">Evidence</span>' + escapeText(layer.summary) + '</p>' +
+            '<p><span class="mini-label">Strong</span>' + escapeText(layer.strong) + '</p>' +
+            '<p><span class="mini-label">Missing</span>' + escapeText(layer.missing) + '<br><span class="tag">' + escapeText(layer.confidence) + ' confidence</span></p>' +
+          '</div>';
+        root.appendChild(row);
+      });
+      requestAnimationFrame(() => {
+        document.querySelectorAll(".bar-fill").forEach((bar) => {
+          bar.style.width = bar.getAttribute("data-width");
+        });
+      });
+    }
+
+    function renderCharts() {
+      const root = $("charts");
+      root.innerHTML = "";
+      const charts = content.quantitative_signals?.charts || [];
+      charts.forEach((chart) => {
+        const div = document.createElement("div");
+        div.className = "panel chart";
+        const series = chart.series?.[0];
+        const points = series?.points || [];
+        const max = Math.max(...points.map((point) => Number(point.value) || 0), 1);
+        const bars = points.map((point) => {
+          const width = ((Number(point.value) || 0) / max) * 100;
+          return '<div class="bar-line">' +
+            '<span>' + escapeText(point.period) + '</span>' +
+            '<div class="thin-track"><div class="thin-fill" data-width="' + width.toFixed(1) + '%"></div></div>' +
+            '<strong>' + escapeText(point.value) + '</strong>' +
+          '</div>';
+        }).join("");
+        div.innerHTML =
+          '<div class="chart-title"><span>' + escapeText(chart.title) + '</span><span class="small">' + escapeText(series?.unit || "") + '</span></div>' +
+          '<p class="small">' + escapeText(chart.description) + '</p>' +
+          '<div class="bars">' + bars + '</div>' +
+          refs(chart.source_ids, chart.evidence_ids);
+        root.appendChild(div);
+      });
+      requestAnimationFrame(() => {
+        document.querySelectorAll(".thin-fill").forEach((bar) => {
+          bar.style.width = bar.getAttribute("data-width");
+        });
+      });
+    }
+
+    function renderSources() {
+      const root = $("sources");
+      root.innerHTML = "";
+      (data.sources || []).forEach((source) => {
+        const row = document.createElement("div");
+        row.className = "source-row";
+        row.innerHTML =
+          '<strong>' + escapeText(source.source_id) + '</strong>' +
+          '<div><a href="' + source.url + '" target="_blank" rel="noreferrer">' + escapeText(source.title) + '</a><div class="muted">' + escapeText(source.publisher) + '</div></div>' +
+          '<span class="muted">' + escapeText(source.document_date || "") + '</span>';
+        root.appendChild(row);
+      });
+    }
+
+    function render() {
+      text("company-name", data.company);
+      text("ticker", data.ticker);
+      text("run-meta", [data.research_run?.research_date, data.research_run?.run_id].filter(Boolean).join(" | "));
+      text("hero-headline", content.hero?.headline);
+      text("hero-subheadline", content.hero?.subheadline);
+      text("total-score", data.display_total_score);
+      text("verdict", data.verdict);
+      text("gate-status", data.gate_pass ? "Gate passed" : "Gate not passed");
+      text("mode-status", (data.mode || "absolute") + " mode");
+      renderLayers();
+
+      text("thesis-title", content.thesis?.title);
+      text("thesis-summary", content.thesis?.summary);
+      const thesisGrid = $("thesis-grid");
+      thesisGrid.innerHTML = "";
+      (content.thesis?.bullets || []).forEach((item, index) => {
+        thesisGrid.appendChild(panel("Point " + (index + 1), item.text, "", item.source_ids, item.evidence_ids));
+      });
+
+      text("tech-title", content.technology_map?.title);
+      text("tech-summary", content.technology_map?.summary);
+      const techRoot = $("technology-map");
+      techRoot.innerHTML = "";
+      (content.technology_map?.items || []).forEach((item) => {
+        techRoot.appendChild(panel(item.name, item.description, item.maturity, item.source_ids, item.evidence_ids));
+      });
+
+      text("signals-title", content.quantitative_signals?.title);
+      text("signals-summary", content.quantitative_signals?.summary);
+      renderCharts();
+
+      text("commercial-title", content.commercialization_evidence?.title);
+      text("commercial-summary", content.commercialization_evidence?.summary);
+      const commercialRoot = $("commercial-grid");
+      commercialRoot.innerHTML = "";
+      (content.commercialization_evidence?.items || []).forEach((item) => {
+        commercialRoot.appendChild(panel(item.label, item.text, "", item.source_ids, item.evidence_ids));
+      });
+
+      text("gate-title", content.breakthrough_gate?.title);
+      text("gate-summary", content.breakthrough_gate?.summary + " Result: " + (content.breakthrough_gate?.result || ""));
+      renderList($("gate-met"), content.breakthrough_gate?.conditions_met || [], (item) => item.condition);
+      renderList($("gate-not-met"), content.breakthrough_gate?.conditions_not_met || [], (item) => item.condition);
+
+      text("university-title", content.university_research_signals?.title);
+      text("university-summary", content.university_research_signals?.summary);
+      const universityRoot = $("universities");
+      universityRoot.innerHTML = "";
+      (content.university_research_signals?.institutions || []).forEach((item) => {
+        const tag = item.company_attributable ? "company-linked" : "field proxy";
+        universityRoot.appendChild(panel(item.name, item.signal, tag, item.source_ids, item.evidence_ids));
+      });
+
+      text("patents-title", content.patent_signals?.title);
+      text("patents-summary", content.patent_signals?.summary + " " + (content.patent_signals?.interpretation || ""));
+      const patentRoot = $("patents");
+      patentRoot.innerHTML = "";
+      (content.patent_signals?.families || []).forEach((item) => {
+        const meta = [item.publication_or_family_id, item.jurisdictions?.join("/")].filter(Boolean).join(" | ");
+        patentRoot.appendChild(panel(item.title, item.interpretation, meta, item.source_ids, item.evidence_ids));
+      });
+
+      const flagsRoot = $("red-flags");
+      flagsRoot.innerHTML = "";
+      (content.red_flags || []).forEach((flag) => {
+        flagsRoot.appendChild(panel(flag.title, flag.text, flag.severity, flag.source_ids, flag.evidence_ids, "severity-" + flag.severity));
+      });
+
+      text("watch-title", content.watchlist?.title);
+      renderList($("upgrade-list"), content.watchlist?.upgrade_signals || [], (item) => item.text + " Source: " + item.monitoring_source);
+      renderList($("downgrade-list"), content.watchlist?.downgrade_signals || [], (item) => item.text + " Source: " + item.monitoring_source);
+
+      text("snapshot-title", content.operational_snapshot?.title);
+      const snapshotRoot = $("snapshot");
+      snapshotRoot.innerHTML = "";
+      (content.operational_snapshot?.metrics || []).forEach((metric) => {
+        const div = document.createElement("div");
+        div.className = "metric";
+        div.innerHTML =
+          '<div class="metric-value">' + escapeText(metric.value) + '</div>' +
+          '<div class="metric-label">' + escapeText(metric.label) + '</div>' +
+          '<div class="muted small">' + escapeText(metric.period) + '</div>' +
+          refs(metric.source_ids, metric.evidence_ids);
+        snapshotRoot.appendChild(div);
+      });
+
+      text("method-title", content.method_notes?.title);
+      renderList($("method-notes"), (content.method_notes?.notes || []).map((note) => ({ text: note })), (item) => item.text);
+
+      text("bottom-title", content.bottom_line?.title);
+      text("bottom-text", content.bottom_line?.text);
+      renderSources();
+      text("footer", "Scored by " + data.scorer_metadata?.scorer_name + " " + data.scorer_metadata?.scorer_version + " using " + data.scorer_metadata?.formula + ".");
+    }
+
+    render();
+  </script>
+</body>
+</html>
+`;
+
+writeFileSync(outputPath, html, "utf8");

