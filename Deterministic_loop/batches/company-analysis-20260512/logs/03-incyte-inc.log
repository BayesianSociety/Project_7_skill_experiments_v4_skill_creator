+      renderList($("gate-not-met"), content.breakthrough_gate?.conditions_not_met || [], (item) => item.condition);
+
+      text("university-title", content.university_research_signals?.title);
+      text("university-summary", content.university_research_signals?.summary);
+      const universityRoot = $("universities");
+      universityRoot.innerHTML = "";
+      (content.university_research_signals?.institutions || []).forEach((item) => {
+        const tag = item.company_attributable ? "company-linked" : "field proxy";
+        universityRoot.appendChild(panel(item.name, item.signal, tag, item.source_ids, item.evidence_ids));
+      });
+
+      text("patents-title", content.patent_signals?.title);
+      text("patents-summary", content.patent_signals?.summary + " " + (content.patent_signals?.interpretation || ""));
+      const patentRoot = $("patents");
+      patentRoot.innerHTML = "";
+      (content.patent_signals?.families || []).forEach((item) => {
+        const meta = [item.publication_or_family_id, item.jurisdictions?.join("/")].filter(Boolean).join(" | ");
+        patentRoot.appendChild(panel(item.title, item.interpretation, meta, item.source_ids, item.evidence_ids));
+      });
+
+      const flagsRoot = $("red-flags");
+      flagsRoot.innerHTML = "";
+      (content.red_flags || []).forEach((flag) => {
+        flagsRoot.appendChild(panel(flag.title, flag.text, flag.severity, flag.source_ids, flag.evidence_ids, "severity-" + flag.severity));
+      });
+
+      text("watch-title", content.watchlist?.title);
+      renderList($("upgrade-list"), content.watchlist?.upgrade_signals || [], (item) => item.text + " Source: " + item.monitoring_source);
+      renderList($("downgrade-list"), content.watchlist?.downgrade_signals || [], (item) => item.text + " Source: " + item.monitoring_source);
+
+      text("snapshot-title", content.operational_snapshot?.title);
+      const snapshotRoot = $("snapshot");
+      snapshotRoot.innerHTML = "";
+      (content.operational_snapshot?.metrics || []).forEach((metric) => {
+        const div = document.createElement("div");
+        div.className = "metric";
