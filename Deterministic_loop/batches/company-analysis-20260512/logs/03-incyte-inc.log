+      "sources": "source_id",
+      "evidence_items": "evidence_id",
+      "metrics": "company + research_date + run_id + layer + metric_code"
+    },
+    "content_hash_fields": [
+      "sources",
+      "evidence_items",
+      "layers",
+      "dashboard_content",
+      "claims",
+      "normalization_notes"
+    ]
+  }
+}
