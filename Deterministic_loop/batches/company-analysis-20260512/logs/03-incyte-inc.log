+
+    h1, h2, h3 {
+      margin: 0;
+      color: var(--burgundy);
+      font-family: FreeSans, Arial, Helvetica, sans-serif;
+      letter-spacing: 0;
+    }
+
+    h1 {
+      margin-top: 12px;
+      max-width: 870px;
+      font-size: clamp(38px, 6vw, 76px);
+      line-height: 0.96;
+    }
+
+    h2 {
+      font-size: clamp(24px, 3vw, 38px);
+      line-height: 1.08;
+    }
+
+    h3 {
+      font-size: 16px;
