+++ b/scripts/build_innovation_dashboard.mjs
@@ -0,0 +1,854 @@
+import { readFileSync, writeFileSync } from "node:fs";
+
+const [scoredPath, outputPath] = process.argv.slice(2);
+
+if (!scoredPath || !outputPath) {
+  console.error("Usage: node scripts/build_innovation_dashboard.mjs <scored.json> <dashboard.html>");
+  process.exit(1);
+}
+
+const scored = JSON.parse(readFileSync(scoredPath, "utf8"));
+const embedded = JSON.stringify(scored, null, 2).replace(/</g, "\\u003c");
+
+const html = `<!doctype html>
