+
+  <script>
+    const data = JSON.parse(document.getElementById("scored-data").textContent);
+    const content = data.dashboard_content || {};
+    const sourceMap = new Map((data.sources || []).map((source) => [source.source_id, source]));
+
+    const $ = (id) => document.getElementById(id);
+
+    function text(id, value) {
+      const node = $(id);
+      if (node) node.textContent = value || "";
+    }
+
+    function escapeText(value) {
+      return String(value ?? "");
+    }
+
+    function refs(sourceIds = [], evidenceIds = []) {
+      const sourceLinks = (sourceIds || [])
+        .map((id) => {
+          const source = sourceMap.get(id);
+          if (!source) return "";
+          return '<a href="' + source.url + '" target="_blank" rel="noreferrer">' + id + '</a>';
+        })
+        .join("");
+      const evidence = (evidenceIds || []).map((id) => '<span>' + id + '</span>').join(" ");
+      if (!sourceLinks && !evidence) return "";
+      return '<div class="refs">' + sourceLinks + (evidence ? '<span>' + evidence + '</span>' : "") + '</div>';
+    }
+
+    function panel(titleValue, bodyValue, metaValue, sourceIds, evidenceIds, extraClass = "") {
+      const div = document.createElement("div");
+      div.className = "panel " + extraClass;
+      div.innerHTML =
+        '<h3>' + escapeText(titleValue) + '</h3>' +
+        '<p class="small">' + escapeText(bodyValue) + '</p>' +
+        (metaValue ? '<span class="tag">' + escapeText(metaValue) + '</span>' : "") +
+        refs(sourceIds, evidenceIds);
+      return div;
+    }
+
+    function renderList(node, items, pickText) {
+      node.innerHTML = "";
+      (items || []).forEach((item) => {
+        const li = document.createElement("li");
+        const body = pickText(item);
+        li.innerHTML = '<p class="small">' + escapeText(body) + '</p>' + refs(item.source_ids, item.evidence_ids);
+        node.appendChild(li);
+      });
+    }
+
+    function renderLayers() {
+      const root = $("layers");
+      root.innerHTML = "";
+      (data.layers || []).forEach((layer, index) => {
+        const row = document.createElement("article");
+        row.className = "layer-row";
+        row.style.animationDelay = (index * 70) + "ms";
+        const percent = Math.max(0, Math.min(100, (Number(layer.score) / 5) * 100));
+        row.innerHTML =
+          '<div class="layer-top">' +
+            '<h3>' + escapeText(layer.label) + '</h3>' +
+            '<div class="bar-track" aria-hidden="true"><div class="bar-fill" data-width="' + percent.toFixed(1) + '%"></div></div>' +
+            '<div class="layer-score">' + escapeText(layer.display_score ?? layer.score) + ' / 5</div>' +
+          '</div>' +
+          '<div class="layer-copy">' +
+            '<p><span class="mini-label">Evidence</span>' + escapeText(layer.summary) + '</p>' +
+            '<p><span class="mini-label">Strong</span>' + escapeText(layer.strong) + '</p>' +
+            '<p><span class="mini-label">Missing</span>' + escapeText(layer.missing) + '<br><span class="tag">' + escapeText(layer.confidence) + ' confidence</span></p>' +
+          '</div>';
+        root.appendChild(row);
+      });
+      requestAnimationFrame(() => {
+        document.querySelectorAll(".bar-fill").forEach((bar) => {
+          bar.style.width = bar.getAttribute("data-width");
+        });
+      });
+    }
+
+    function renderCharts() {
+      const root = $("charts");
+      root.innerHTML = "";
+      const charts = content.quantitative_signals?.charts || [];
+      charts.forEach((chart) => {
+        const div = document.createElement("div");
+        div.className = "panel chart";
+        const series = chart.series?.[0];
+        const points = series?.points || [];
+        const max = Math.max(...points.map((point) => Number(point.value) || 0), 1);
+        const bars = points.map((point) => {
+          const width = ((Number(point.value) || 0) / max) * 100;
+          return '<div class="bar-line">' +
+            '<span>' + escapeText(point.period) + '</span>' +
+            '<div class="thin-track"><div class="thin-fill" data-width="' + width.toFixed(1) + '%"></div></div>' +
+            '<strong>' + escapeText(point.value) + '</strong>' +
+          '</div>';
+        }).join("");
+        div.innerHTML =
+          '<div class="chart-title"><span>' + escapeText(chart.title) + '</span><span class="small">' + escapeText(series?.unit || "") + '</span></div>' +
+          '<p class="small">' + escapeText(chart.description) + '</p>' +
+          '<div class="bars">' + bars + '</div>' +
+          refs(chart.source_ids, chart.evidence_ids);
+        root.appendChild(div);
+      });
+      requestAnimationFrame(() => {
+        document.querySelectorAll(".thin-fill").forEach((bar) => {
+          bar.style.width = bar.getAttribute("data-width");
+        });
+      });
+    }
+
+    function renderSources() {
+      const root = $("sources");
+      root.innerHTML = "";
+      (data.sources || []).forEach((source) => {
+        const row = document.createElement("div");
+        row.className = "source-row";
+        row.innerHTML =
+          '<strong>' + escapeText(source.source_id) + '</strong>' +
+          '<div><a href="' + source.url + '" target="_blank" rel="noreferrer">' + escapeText(source.title) + '</a><div class="muted">' + escapeText(source.publisher) + '</div></div>' +
+          '<span class="muted">' + escapeText(source.document_date || "") + '</span>';
+        root.appendChild(row);
+      });
+    }
+
+    function render() {
+      text("company-name", data.company);
+      text("ticker", data.ticker);
+      text("run-meta", [data.research_run?.research_date, data.research_run?.run_id].filter(Boolean).join(" | "));
+      text("hero-headline", content.hero?.headline);
+      text("hero-subheadline", content.hero?.subheadline);
+      text("total-score", data.display_total_score);
+      text("verdict", data.verdict);
+      text("gate-status", data.gate_pass ? "Gate passed" : "Gate not passed");
+      text("mode-status", (data.mode || "absolute") + " mode");
+      renderLayers();
+
+      text("thesis-title", content.thesis?.title);
+      text("thesis-summary", content.thesis?.summary);
+      const thesisGrid = $("thesis-grid");
+      thesisGrid.innerHTML = "";
+      (content.thesis?.bullets || []).forEach((item, index) => {
+        thesisGrid.appendChild(panel("Point " + (index + 1), item.text, "", item.source_ids, item.evidence_ids));
+      });
+
+      text("tech-title", content.technology_map?.title);
+      text("tech-summary", content.technology_map?.summary);
+      const techRoot = $("technology-map");
+      techRoot.innerHTML = "";
+      (content.technology_map?.items || []).forEach((item) => {
+        techRoot.appendChild(panel(item.name, item.description, item.maturity, item.source_ids, item.evidence_ids));
+      });
+
+      text("signals-title", content.quantitative_signals?.title);
+      text("signals-summary", content.quantitative_signals?.summary);
+      renderCharts();
+
+      text("commercial-title", content.commercialization_evidence?.title);
+      text("commercial-summary", content.commercialization_evidence?.summary);
+      const commercialRoot = $("commercial-grid");
+      commercialRoot.innerHTML = "";
+      (content.commercialization_evidence?.items || []).forEach((item) => {
+        commercialRoot.appendChild(panel(item.label, item.text, "", item.source_ids, item.evidence_ids));
+      });
+
+      text("gate-title", content.breakthrough_gate?.title);
+      text("gate-summary", content.breakthrough_gate?.summary + " Result: " + (content.breakthrough_gate?.result || ""));
+      renderList($("gate-met"), content.breakthrough_gate?.conditions_met || [], (item) => item.condition);
+      renderList($("gate-not-met"), content.breakthrough_gate?.conditions_not_met || [], (item) => item.condition);
+
+      text("university-title", content.university_research_signals?.title);
+      text("university-summary", content.university_research_signals?.summary);
+      const universityRoot = $("universities");
+      universityRoot.innerHTML = "";
+      (content.university_research_signals?.institutions || []).forEach((item) => {
