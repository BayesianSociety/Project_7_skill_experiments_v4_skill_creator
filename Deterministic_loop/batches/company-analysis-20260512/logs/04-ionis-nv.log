+      return `<div class="chart"><h3>${{esc(chart.title)}}</h3><p>${{esc(chart.description)}}</p><div class="bars">${{rows}}</div></div>`;
+    }}).join('');
+
+    $('commercialTitle').textContent = c.commercialization_evidence.title;
