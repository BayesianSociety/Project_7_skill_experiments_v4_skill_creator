from typing import Iterable


REQUIRED_LAYERS = (
    "Science",
    "IP",
    "Industrialization",
    "Adoption",
    "Policy & Economics",
)

REQUIRED_LAYER_METRICS = {
    "Science": (
        "publication_growth",
