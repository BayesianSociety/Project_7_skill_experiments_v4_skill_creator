+      </div>
+    </div>
+  </header>
+  <main class="shell">
+    <div class="layout">
+      <div>
+        <section>
+          <h2>Five-Layer Dashboard</h2>
+          <p id="layerIntro"></p>
+          <div class="layers" id="layers"></div>
+        </section>
+        <section>
+          <h2 id="thesisTitle"></h2>
+          <p id="thesisSummary"></p>
