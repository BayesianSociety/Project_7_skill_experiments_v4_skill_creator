+    .severity-medium {{ color: var(--amber); }}
+    .sources {{
+      display: grid;
+      gap: 10px;
+      font-size: 13px;
+    }}
+    .source-row {{
+      display: grid;
+      grid-template-columns: 110px minmax(0, 1fr) 132px;
+      gap: 12px;
+      padding: 11px 0;
+      border-bottom: 1px solid var(--line);
+      color: var(--muted);
+    }}
+    .source-row strong {{ color: var(--burgundy); }}
+    .reveal {{
+      opacity: 0;
+      transform: translateY(16px);
+      transition: opacity 600ms ease, transform 600ms ease;
