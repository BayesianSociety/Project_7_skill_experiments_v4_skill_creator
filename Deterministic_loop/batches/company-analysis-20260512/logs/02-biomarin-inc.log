+    header {{
+      padding: 30px 0 22px;
+      border-bottom: 1px solid var(--line);
+    }}
+    .eyebrow {{
+      color: var(--clay);
+      font-size: 12px;
+      letter-spacing: 0;
+      text-transform: uppercase;
+      font-weight: 700;
+    }}
+    h1, h2, h3 {{
+      font-family: FreeSans, Arial, Helvetica, sans-serif;
+      letter-spacing: 0;
+      margin: 0;
+      color: var(--burgundy);
