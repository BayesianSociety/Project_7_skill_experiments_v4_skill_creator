+def metric(code, label, value, weight, evidence_ids, raw_inputs, method, rationale, judgment_level="medium"):
+    return {
+        "code": code,
+        "label": label,
+        "value": value,
+        "weight": weight,
+        "unit": "normalized_0_to_1",
+        "source_type": "mixed",
+        "verified": True,
+        "evidence_ids": evidence_ids,
+        "normalization": {
+            "raw_inputs": raw_inputs,
+            "method": method,
+            "parameters": {"floor": 0.0, "cap": 1.0},
