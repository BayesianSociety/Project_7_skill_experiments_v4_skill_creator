+      font-weight: 700;
+      margin-top: 10px;
+    }}
+    .chart {{
+      display: grid;
+      gap: 10px;
+    }}
+    .bars {{
+      display: grid;
+      gap: 8px;
+      margin-top: 12px;
+    }}
+    .bar-line {{
+      display: grid;
+      grid-template-columns: 62px minmax(0, 1fr) 72px;
+      gap: 10px;
+      align-items: center;
+      font-size: 12px;
+      color: var(--muted);
+    }}
+    .thin-track {{
+      height: 7px;
+      border-radius: 999px;
+      overflow: hidden;
+      background: rgba(93, 46, 70, 0.12);
+    }}
+    .thin-fill {{
+      height: 100%;
+      width: 0%;
